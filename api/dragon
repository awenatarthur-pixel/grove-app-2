import { createClient } from '@supabase/supabase-js';

const supabaseAdmin = createClient(
  process.env.VITE_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

// Places or removes the signed-in user's Friendly Dragon. The browser can no longer
// write to the profiles table directly, so this is the only way the dragon state changes.
// Rules: a dragon can only be placed if the user has earned one and has none placed;
// it can only be removed (returned to the bank) if one is currently placed. Max 1, ever.
export default async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });

  const authHeader = req.headers.authorization || '';
  const token = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : null;
  if (!token) return res.status(401).json({ error: 'Not authenticated' });

  const { data: userData, error: authErr } = await supabaseAdmin.auth.getUser(token);
  if (authErr || !userData?.user) return res.status(401).json({ error: 'Invalid session' });
  const userId = userData.user.id;

  const { action } = req.body || {};
  if (action !== 'place' && action !== 'remove') return res.status(400).json({ error: 'Unknown action' });

  try {
    // The extra .eq() filters make each change conditional, so two quick taps can't both succeed.
    const query = supabaseAdmin.from('profiles');
    const { data, error } = action === 'place'
      ? await query.update({ flowers: 0, dragon_placed: true })
          .eq('id', userId).gt('flowers', 0).eq('dragon_placed', false)
          .select('flowers, dragon_placed')
      : await query.update({ flowers: 1, dragon_placed: false })
          .eq('id', userId).eq('dragon_placed', true)
          .select('flowers, dragon_placed');

    if (error) return res.status(500).json({ error: error.message });
    if (!data || data.length === 0) return res.status(200).json({ success: false, reason: 'not allowed' });
    res.status(200).json({ success: true, ...data[0] });
  } catch (err) {
    console.error('Dragon error:', err);
    res.status(500).json({ error: err.message });
  }
}
